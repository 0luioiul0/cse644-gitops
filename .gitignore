# Never commit credentials. The assignment's security rules forbid kubeconfig
# files, tokens, keys and secret values - and in a GitOps repository the stakes
# are higher than usual, because this repository is applied to a cluster
# automatically.
kubeconfig
*.kubeconfig
.kube/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
**/secrets/

# Secret manifests, with one deliberate exception: the template that carries a
# placeholder and documents why the real value is created outside Git.
*secret*.yaml
!k8s/21-api-secret.example.yaml

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
