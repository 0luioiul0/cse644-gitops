# Never commit credentials. The assignment's security rules forbid kubeconfig
# files, tokens, keys and secret values - and in a GitOps repository the stakes
# are higher than usual, because this repository is applied to a cluster
# automatically.
kubeconfig
*.kubeconfig
.kube/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
**/secrets/

# Secret manifests. The one template in this repository is deliberately named
# k8s/21-api-secret.yaml.example - it does not end in .yaml, so it is neither
# ignored by the rule below nor read by Argo CD, which parses only *.yaml,
# *.yml and *.json in a synced directory.
*secret*.yaml

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
